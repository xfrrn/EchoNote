# pnpm dev and Docker Compose read a copied .env file.

# Shared internal services
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/echonote?sslmode=disable
POSTGRES_PORT=5433
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
ECHONOTE_INTERNAL_TOKEN=CHANGE_ME

# Local self-hosted Keycloak (development only)
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# MCP resource and OAuth 2.1 / OIDC provider
ECHONOTE_PUBLIC_URL=http://127.0.0.1:3001/mcp
ECHONOTE_OAUTH_ISSUER=http://127.0.0.1:8081/realms/echonote
ECHONOTE_OAUTH_AUDIENCE=http://127.0.0.1:3001/mcp
ECHONOTE_MCP_HOST=127.0.0.1
ECHONOTE_MCP_PORT=3001
ECHONOTE_API_URL=http://127.0.0.1:8080

# Production example:
# KEYCLOAK_PUBLIC_URL=https://auth.example.com
# ECHONOTE_PUBLIC_URL=https://mcp.example.com/mcp
# ECHONOTE_OAUTH_ISSUER=https://auth.example.com/realms/echonote
# ECHONOTE_OAUTH_AUDIENCE=https://mcp.example.com/mcp

# Aliyun ASR
ASR_PROVIDER=aliyun
ASR_API_KEY=CHANGE_ME
ASR_QUALITY_MODEL=fun-asr

# SnapAny social post and list-page extraction
SNAPANY_API_KEY=CHANGE_ME

# Aliyun OSS temporary audio storage
STORAGE_PROVIDER=aliyun_oss
STORAGE_REGION=cn-beijing
STORAGE_BUCKET=CHANGE_ME
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Production/staging database safety checks
# EXPECTED_DATABASE_NAME=echonote
# DATABASE_CONNECTION_BUDGET=20
