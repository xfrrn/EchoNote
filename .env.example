# 环境变量示例
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中忽略，勿提交真实密钥。

# ---- 服务 ----
# 后端 HTTP 端口
SERVER_PORT=8080
# 运行环境：development | production
APP_ENV=development

# ---- 数据库 ----
# Postgres 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echonote?sslmode=disable

# ---- 对象存储（音频 / 转写产物）----
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- ASR（语音转写）----
ASR_PROVIDER=
ASR_API_KEY=

# ---- LLM / Embedding（总结、对话、检索）----
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
