# 环境变量示例
# .env 已在 .gitignore 中忽略；Go 服务只读取进程环境，请由 shell 或部署工具注入，勿提交真实密钥。

# ---- 服务 ----
# 后端 HTTP 端口
SERVER_PORT=8080
# 运行环境：development | production
APP_ENV=development
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ---- 数据库 ----
# Postgres 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echonote?sslmode=disable

# ---- Worker / PostgreSQL Job Queue ----
# 空队列轮询间隔（Go duration）
WORKER_POLL_INTERVAL=1s
# Job 锁租约；Worker 会定时续租并回收超时任务
WORKER_LEASE_TIMEOUT=5m

# ---- Docker Compose 本地 PostgreSQL ----
POSTGRES_DB=echonote
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- 对象存储（音频 / 转写产物）----
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- ASR（语音转写）----
ASR_PROVIDER=
ASR_API_KEY=

# ---- LLM / Embedding（总结、对话、检索）----
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
