# 环境变量示例
# .env 已在 .gitignore 中忽略；Go 服务只读取进程环境，请由 shell 或部署工具注入，勿提交真实密钥。

# ---- 服务 ----
# 后端 HTTP 端口
SERVER_PORT=8080
# 运行环境：development | test | staging | production
APP_ENV=development
# PWA 与 API 的唯一公开 Origin；staging / production 必填且必须为 HTTPS
PUBLIC_ORIGIN=
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 仅 development / test 可用的无登录身份；staging / production 设置后会拒绝启动
ECHONOTE_USER_ID=00000000-0000-4000-8000-000000000001
# Session 明确过期时间（Go duration）
SESSION_TTL=720h
# 先在目标主机执行 `go run ./cmd/admin benchmark-password`，再固定该值（10-16）
PASSWORD_BCRYPT_COST=12

# ---- 数据库 ----
# Postgres 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echonote?sslmode=disable

# ---- Worker / PostgreSQL Job Queue ----
# 空队列轮询间隔（Go duration）
WORKER_POLL_INTERVAL=1s
# Job 锁租约；Worker 会定时续租并回收超时任务
WORKER_LEASE_TIMEOUT=5m

# ---- Docker Compose 本地 PostgreSQL ----
POSTGRES_DB=echonote
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- 对象存储（音频 / 转写产物）----
# Phase 5 启用值：aliyun_oss
STORAGE_PROVIDER=
# 例如 cn-beijing
STORAGE_REGION=
# 可选；自定义值必须是无凭据 HTTPS URL
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- ASR（语音转写）----
# Phase 5 启用值：aliyun
ASR_PROVIDER=
ASR_API_KEY=
# 默认 https://dashscope.aliyuncs.com；生产建议使用百炼 Workspace 专属 HTTPS 域名
ASR_ENDPOINT=https://dashscope.aliyuncs.com
# 每次 poll_asr Job 之间的延迟，不在 Worker 内 sleep
ASR_POLL_INTERVAL=5s

# ---- 音频工具 ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- LLM / Embedding（总结、对话、检索）----
# Phase 7 启用值：aliyun；留空时禁用生成，已保存结果仍可读取
LLM_PROVIDER=
LLM_API_KEY=
# OpenAI-compatible base URL；生产按 API Key 地域配置 Workspace HTTPS 地址
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可固定为百炼支持的 snapshot；默认使用 qwen-plus
LLM_MODEL=qwen-plus
# Phase 6 启用值：aliyun；留空时保留关键词搜索
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
# 默认 https://dashscope.aliyuncs.com；生产建议使用百炼 Workspace 专属 HTTPS 域名
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com
