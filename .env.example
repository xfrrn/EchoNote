# EchoNote 本地开发配置
# Go 不会自动读取 .env；请通过 shell 或运行工具注入，勿提交真实密钥。

# 必填：PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echonote?sslmode=disable

# 必填：该 MCP 服务拥有的数据分区 UUID
ECHONOTE_OWNER_ID=00000000-0000-4000-8000-000000000001

# MCP 连接本机内部 API（默认值如下）
ECHONOTE_API_URL=http://127.0.0.1:8080
# ECHONOTE_MCP_PORT=3001

# 语音转写（不需要此功能时，可忽略下面整段）
# 1. 两个模型都会显示给用户选择
ASR_STANDARD_MODEL=paraformer-v2
ASR_QUALITY_MODEL=fun-asr

# 2. 两个模型共用同一个阿里云百炼 API Key
# ASR_PROVIDER=aliyun
# ASR_API_KEY=CHANGE_ME

# 3. 阿里云 OSS 只暂存待转写音频，使用完成后程序会自动删除
# STORAGE_PROVIDER=aliyun_oss
# STORAGE_REGION=cn-beijing
# STORAGE_BUCKET=CHANGE_ME
# STORAGE_ACCESS_KEY=CHANGE_ME
# STORAGE_SECRET_KEY=CHANGE_ME

# 可选：语义搜索
# EMBEDDING_PROVIDER=aliyun
# EMBEDDING_API_KEY=CHANGE_ME

# 可选：AI 总结与对话
# LLM_PROVIDER=aliyun
# LLM_API_KEY=CHANGE_ME
