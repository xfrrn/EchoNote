# EchoNote 本地开发配置
# Go 不会自动读取 .env；请通过 shell 或运行工具注入，勿提交真实密钥。

# 必填：PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echonote?sslmode=disable

# 可选：开发环境免登录
ECHONOTE_USER_ID=00000000-0000-4000-8000-000000000001

# 可选：语音转写（需要同时配置以下全部变量）
# ASR_PROVIDER=aliyun
# ASR_API_KEY=CHANGE_ME
# STORAGE_PROVIDER=aliyun_oss
# STORAGE_REGION=cn-beijing
# STORAGE_BUCKET=CHANGE_ME
# STORAGE_ACCESS_KEY=CHANGE_ME
# STORAGE_SECRET_KEY=CHANGE_ME

# 可选：语义搜索
# EMBEDDING_PROVIDER=aliyun
# EMBEDDING_API_KEY=CHANGE_ME

# 可选：AI 总结与对话
# LLM_PROVIDER=aliyun
# LLM_API_KEY=CHANGE_ME

# staging / production 完整配置见 deployments/env/*.example。
