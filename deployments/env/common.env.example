# Copy to /etc/echonote/common.env, keep root:root 0600, and never commit the populated file.
APP_ENV=production
PUBLIC_ORIGIN=https://notes.example.com
EXPECTED_DATABASE_NAME=echonote
DATABASE_CONNECTION_BUDGET=20
TRANSCRIPTION_ENABLED=true
LOG_LEVEL=info
SESSION_TTL=720h
PASSWORD_BCRYPT_COST=12

ASR_ENDPOINT=https://dashscope.aliyuncs.com
ASR_POLL_INTERVAL=5s
EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
STORAGE_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
