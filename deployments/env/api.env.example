# API runtime role and API-only Provider credentials. Replace every CHANGE_ME value via the deployment secret store.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_URL=postgresql://echonote_api:CHANGE_ME@db.internal.example/echonote?sslmode=verify-full&sslrootcert=/etc/echonote/db-ca.pem&pool_max_conns=10

EMBEDDING_PROVIDER=aliyun
EMBEDDING_API_KEY=CHANGE_ME
LLM_PROVIDER=aliyun
LLM_API_KEY=CHANGE_ME
