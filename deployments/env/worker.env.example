# Worker runtime role and worker-only Provider credentials. Replace every CHANGE_ME value via the deployment secret store.
DATABASE_URL=postgresql://echonote_worker:CHANGE_ME@db.internal.example/echonote?sslmode=verify-full&sslrootcert=/etc/echonote/db-ca.pem&pool_max_conns=5
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_TIMEOUT=5m
WORKER_TEMP_MAX_AGE=24h
TMPDIR=/var/lib/echonote/tmp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

ASR_PROVIDER=aliyun
ASR_API_KEY=CHANGE_ME
STORAGE_PROVIDER=aliyun_oss
STORAGE_REGION=cn-beijing
STORAGE_BUCKET=echonote-production-private
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
EMBEDDING_PROVIDER=aliyun
EMBEDDING_API_KEY=CHANGE_ME
LLM_PROVIDER=aliyun
LLM_API_KEY=CHANGE_ME
