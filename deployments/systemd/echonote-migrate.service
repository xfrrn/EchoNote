[Unit]
Description=Apply EchoNote database migrations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=echonote-migrate
Group=echonote-migrate
WorkingDirectory=/opt/echonote/current
EnvironmentFile=/etc/echonote/common.env
EnvironmentFile=/etc/echonote/migration.env
ExecStart=/opt/echonote/current/bin/echonote-migrate up
TimeoutStartSec=10min
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadOnlyPaths=/tmp /var/tmp
