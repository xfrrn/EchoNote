[Unit]
Description=EchoNote Worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=echonote-worker
Group=echonote-worker
WorkingDirectory=/opt/echonote/current
EnvironmentFile=/etc/echonote/common.env
EnvironmentFile=/etc/echonote/worker.env
ExecStartPre=/opt/echonote/current/bin/echonote-worker --check-config
ExecStart=/opt/echonote/current/bin/echonote-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
InaccessiblePaths=/tmp /var/tmp
ReadWritePaths=/var/lib/echonote/tmp

[Install]
WantedBy=multi-user.target
