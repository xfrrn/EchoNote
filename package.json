{
  "name": "echonote",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "description": "EchoNote MCP service",
  "scripts": {
    "build": "pnpm --filter @echonote/mcp build",
    "test": "pnpm --filter @echonote/mcp test",
    "mcp": "pnpm --filter @echonote/mcp build && pnpm --filter @echonote/mcp start",
    "mcp:http": "pnpm --filter @echonote/mcp build && pnpm --filter @echonote/mcp start:http"
  }
}
